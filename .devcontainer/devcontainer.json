{
  "name": "Windows 10 Pro",
  "service": "windows",
  "containerEnv": {
    "VERSION": "10"
  },
  "forwardPorts": [8006, 3389],
  "portsAttributes": {
    "8006": {
      "label": "Windows Web",
      "onAutoForward": "notify"
    },
    "3389": {
      "label": "Windows RDP",
      "onAutoForward": "silent"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "dockerComposeFile": "codespaces.yml",
  "initializeCommand": "docker system prune --all --force"
}
